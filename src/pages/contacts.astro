---
import Base from '../layouts/Base.astro';
import Video from '../components/Video.astro';
import { site } from '../data/site';
import { clips } from '../data/media';
import { cases } from '../data/cases';

const credits: { role: string; names: string[] }[] = [
  { role: 'Основатель студии', names: [site.person] },
  { role: 'Студия', names: ['NARRA'] },
  { role: 'Направления', names: ['Фирменный стиль', 'Полиграфия', 'Социальные сети', 'Съёмки'] },
  { role: 'Метод', names: ['Смысл', 'Структура', 'Ясность'] },
  { role: 'Кейсы', names: cases.map((c) => c.title) },
  { role: 'В главной роли', names: ['Ваш бренд'] },
];

const contacts = [
  { label: 'Instagram', value: `@${site.instagram}`, href: `https://instagram.com/${site.instagram}` },
  { label: 'Telegram', value: `@${site.telegram}`, href: `https://t.me/${site.telegram}` },
  { label: 'Почта', value: site.email, href: `mailto:${site.email}` },
];
---

<Base title="Контакты — Полина, NARRA STUDIO" scene="Сцена 03" sceneTitle="Контакты">
  <section class="finale" aria-labelledby="finale-title">
    <div class="finale__media"><Video clip={clips.cinema} eager /></div>
    <div class="finale__shade"></div>

    <div class="finale__grid wrap">
      <div class="finale__main">
        <p class="mono finale__scene">Сцена 03 — Контакты</p>
        <h1 class="finale__title display" id="finale-title">Обсудим<br />ваш проект</h1>
        <p class="lede">Расскажите о задаче в паре строк — ответим в директе и договоримся о созвоне.</p>
        <a class="go mono finale__cta" href={`https://ig.me/m/${site.instagram}`} target="_blank" rel="noopener">
          Написать в директ <span class="go__arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="credits" aria-label="Финальные титры">
        <div class="credits__roll">
          {
            [0, 1].map((copy) => (
              <div class="credits__block" aria-hidden={copy ? 'true' : undefined}>
                {credits.map((c) => (
                  <div class="credits__item">
                    <p class="credits__role mono">{c.role}</p>
                    {c.names.map((n) => <p class="credits__name display">{n}</p>)}
                  </div>
                ))}
                <p class="credits__end mono">Продолжение следует</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <ul class="contacts mono">
      {
        contacts.map((c) => (
          <li>
            <a class="contacts__cell" href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
              <span class="contacts__label">{c.label}</span>
              <span class="contacts__value">{c.value}</span>
              <span class="contacts__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .finale {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
  }
  .finale__media,
  .finale__shade { position: absolute; inset: 0; }
  .finale__shade {
    background:
      radial-gradient(70% 60% at 50% 40%, transparent, rgb(13 12 10 / 0.7)),
      linear-gradient(to right, rgb(13 12 10 / 0.85), rgb(13 12 10 / 0.25) 60%, rgb(13 12 10 / 0.6));
  }

  .finale__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--gutter);
    padding-top: calc(var(--bar-h) + 6svh);
    padding-bottom: 6svh;
  }
  .finale__main {
    display: grid;
    align-content: end;
    justify-items: start;
    gap: 26px;
  }
  .finale__scene { color: var(--edge); }
  .finale__title {
    font-size: clamp(76px, 11.5vw, 200px);
    line-height: 0.84;
  }
  .finale__cta { background: var(--silver); color: var(--base); border-color: var(--silver); }
  .finale__cta:hover { background: transparent; color: var(--silver); }

  /* ── Титры ── */
  .credits {
    position: relative;
    height: min(72svh, 640px);
    align-self: end;
    overflow: hidden;
    -webkit-mask: linear-gradient(transparent, #000 18%, #000 82%, transparent);
    mask: linear-gradient(transparent, #000 18%, #000 82%, transparent);
  }
  .credits__roll { animation: roll 46s linear infinite; }
  .credits:hover .credits__roll { animation-play-state: paused; }
  .credits__block {
    display: grid;
    justify-items: center;
    gap: 44px;
    padding-block: 40px;
    text-align: center;
  }
  .credits__item { display: grid; gap: 6px; }
  .credits__role { color: var(--silver-45); margin-bottom: 4px; }
  .credits__name { font-size: clamp(26px, 2.4vw, 38px); line-height: 1.05; }
  .credits__end { color: var(--edge); padding-bottom: 40px; }
  @keyframes roll { to { transform: translateY(-50%); } }

  @media (prefers-reduced-motion: reduce) {
    .credits { overflow-y: auto; }
    .credits__block + .credits__block { display: none; }
  }

  /* ── Ячейки контактов — в той же манере, что шапка ── */
  .contacts {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    background: var(--silver);
    color: var(--base);
  }
  .contacts li { border-right: 1px solid var(--line-ink); }
  .contacts li:last-child { border-right: 0; }
  .contacts__cell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px 16px;
    padding: 20px 18px;
    transition: background-color 0.25s, color 0.25s;
  }
  .contacts__label { color: rgb(13 12 10 / 0.5); }
  .contacts__value {
    grid-column: 1;
    font-size: 13px;
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .contacts__arrow { grid-row: 1 / 3; grid-column: 2; align-self: center; font-size: 16px; }
  .contacts__cell:hover { background: var(--base); color: var(--silver); }
  .contacts__cell:hover .contacts__label { color: var(--silver-45); }

  @media (max-width: 860px) {
    .finale__grid { grid-template-columns: 1fr; }
    .credits { height: 46svh; }
    .contacts { grid-template-columns: 1fr; }
    .contacts li { border-right: 0; border-bottom: 1px solid var(--line-ink); }
  }
</style>

<script>
  import { gsap, reduced } from '../scripts/core';

  if (!reduced) {
    gsap.timeline({ defaults: { ease: 'expo.out' }, delay: 0.4 })
      .from('.finale__media .vid', { scale: 1.2, duration: 2.4, ease: 'power3.out' }, 0)
      .from('.finale__main > *', { autoAlpha: 0, y: 34, duration: 1.2, stagger: 0.1 }, 0.4)
      .from('.credits', { autoAlpha: 0, duration: 1.6, ease: 'power1.out' }, 0.9)
      .from('.contacts li', { yPercent: 100, autoAlpha: 0, duration: 1, stagger: 0.08 }, 0.9);
  }
</script>
